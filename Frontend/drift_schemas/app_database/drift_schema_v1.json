    {
      "name": "cached_notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_notes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"user_id\" INTEGER NOT NULL, \"server_id\" INTEGER NULL, \"title\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"category\" TEXT NULL, \"created_at\" TEXT NULL, \"updated_at\" TEXT NULL, \"tags\" TEXT NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), \"is_pending\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_pending\" IN (0, 1)), UNIQUE (\"user_id\", \"server_id\"));"
        }
      ]
    },
    {
      "name": "pending_notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_notes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"user_id\" INTEGER NOT NULL, \"local_note_id\" INTEGER NOT NULL, \"payload\" TEXT NOT NULL, \"queued_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"local_note_id\"));"
        }
      ]
    },
    {
      "name": "cached_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cached_profiles\" (\"user_id\" INTEGER NOT NULL, \"profile_id\" INTEGER NULL, \"name\" TEXT NULL, \"email\" TEXT NULL, \"mobile\" TEXT NULL, \"gender\" TEXT NULL, PRIMARY KEY (\"user_id\"));"
        }
      ]
